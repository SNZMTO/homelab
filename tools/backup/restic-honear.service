# Honear's backup (/usr/local/lib/restic-honear/backup.sh), run every night by restic-honear.timer. As root, to read the
# containers' folders, but with no right other than reading: it only writes to its cache. Its settings come from
# /etc/restic/honear.env, 0600. Installed in /etc/systemd/system (docs/sauvegardes.md).
[Unit]
Description=Honear: backs up the players' accounts and the MCP's lists, with restic
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/restic/honear.env
Environment=RESTIC_CACHE_DIR=/var/cache/restic-honear
CacheDirectory=restic-honear
CacheDirectoryMode=0700
ExecStart=/bin/sh /usr/local/lib/restic-honear/backup.sh
# The game comes first: the backup takes the CPU and the disk when they are free.
Nice=10
CPUWeight=20
IOWeight=20
# Read the whole machine, write only to its cache.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
