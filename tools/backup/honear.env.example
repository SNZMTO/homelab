# The template for /etc/restic/honear.env, read by restic-honear.service: paths and an address, no secret. Install it as root
# and 0600 (it may later hold access keys), then fill it in:
#   sudo install -m 0600 tools/backup/honear.env.example /etc/restic/honear.env

# Where the backups go: off the server, and inside the European Union, since this is personal data. For example, an SFTP
# server:
#   RESTIC_REPOSITORY=sftp:sauvegarde@sauvegarde.example:/restic/honear
# or S3-compatible object storage, whose two access keys are then added here (AWS_ACCESS_KEY_ID=, AWS_SECRET_ACCESS_KEY=):
#   RESTIC_REPOSITORY=s3:https://s3.example.net/honear-sauvegardes
RESTIC_REPOSITORY=

# The file holding the password that encrypts the backups: owned by root, 0600 (backup.sh checks it). It is also kept off
# the server, in Mateo's password manager: without it, no backup can be read back.
RESTIC_PASSWORD_FILE=/etc/restic/honear.mot-de-passe

# Honear's data, including the players' accounts (e-mail addresses, scores). This is the expected path, but no log in this
# repository writes it down: check it before installing (docs/sauvegardes.md).
HONEAR_DATA=/var/lib/honear
# The lists the MCP stores. No document in this repository gives their folder: find it (docs/sauvegardes.md).
HONEAR_MCP_LISTES=
