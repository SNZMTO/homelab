# Le modèle de /etc/restic/honear.env, que lit restic-honear.service : des chemins et une adresse, aucun secret. À poser en
# root et en 0600 (il recevra peut-être des clés d'accès), puis à remplir :
#   sudo install -m 0600 outils/sauvegarde/honear.env.exemple /etc/restic/honear.env

# Où vont les sauvegardes : hors du serveur, et dans l'Union européenne, puisque ce sont des données personnelles. Par
# exemple, un serveur SFTP :
#   RESTIC_REPOSITORY=sftp:sauvegarde@sauvegarde.example:/restic/honear
# ou un stockage objet compatible S3, dont les deux clés d'accès s'ajoutent alors ici (AWS_ACCESS_KEY_ID=,
# AWS_SECRET_ACCESS_KEY=) :
#   RESTIC_REPOSITORY=s3:https://s3.example.net/honear-sauvegardes
RESTIC_REPOSITORY=

# Le fichier du mot de passe qui chiffre les sauvegardes : à root, en 0600 (sauvegarder.sh le vérifie). Il est aussi gardé
# hors du serveur, dans le gestionnaire de mots de passe de Mateo : sans lui, aucune sauvegarde ne se relit.
RESTIC_PASSWORD_FILE=/etc/restic/honear.mot-de-passe

# Les données de Honear, dont les comptes des joueurs (adresses e-mail, scores). C'est le chemin attendu, mais aucun journal
# de ce dépôt ne l'écrit : le vérifier avant d'installer (docs/sauvegardes.md).
HONEAR_DONNEES=/var/lib/honear
# Les listes que le MCP enregistre. Aucun document de ce dépôt ne donne leur dossier : le trouver (docs/sauvegardes.md).
HONEAR_MCP_LISTES=
