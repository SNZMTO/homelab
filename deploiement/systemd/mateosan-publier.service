# Met en ligne le dernier commit de SNZMTO/homelab (deploiement/publier.sh), en tant que mateosan : un utilisateur sans shell ni
# droits, qui n'écrit que dans son dépôt et dans le site. Posé dans /etc/systemd/system par deploiement/mettre-en-ligne.sh.
[Unit]
Description=mateosan.fr : met en ligne le dernier commit de SNZMTO/homelab
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=mateosan
Group=mateosan
UMask=0022
ExecStart=/bin/sh /usr/local/lib/mateosan/publier.sh
# Le jeu passe avant : la construction prend le processeur quand il est libre.
Nice=10
CPUWeight=20
IOWeight=20
# Rien d'autre de la machine ne lui est utile.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/mateosan /srv/mateosan/publie
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
